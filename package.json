{
  "name": "lighthouse-audit-utils",
  "version": "1.2.1",
  "description": "Small utilities for driving Lighthouse audits yourself: check scores against thresholds, write reports to disk, and log the fix list to the terminal.",
  "keywords": [
    "lighthouse",
    "playwright",
    "performance",
    "ci",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bvandrc/lighthouse-audit-utils"
  },
  "author": {
    "name": "Blake Vandercar",
    "email": "bvandercar@outlook.com"
  },
  "license": "MIT",
  "type": "module",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "__c0": "====================[ Build & Development ]======================",
    "prepack": "pnpm build",
    "build": "tsup-node && pnpm build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "start": "tsup-node --watch",
    "__c1": "====================[ Linting & Type Checking ]==================",
    "check": "npx biome check . && pnpm ts:check",
    "format": "npx biome check . --fix",
    "ts:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@playwright/test": "^1",
    "lighthouse": "^12 || ^13"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true,
      "reason": "only needed for the lighthouse-audit-utils/playwright entrypoint"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@playwright/test": "^1",
    "@types/node": "^24",
    "es-toolkit": "^1",
    "lighthouse": "^13",
    "tsup": "^8",
    "typescript": "^7"
  }
}
